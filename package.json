{
  "name": "@marketrix.ai/widget",
  "version": "3.8.40",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/widget.mjs",
  "module": "./dist/widget.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/widget.mjs",
      "default": "./dist/widget.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tag": "bash scripts/release.sh",
    "start": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 200 --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "check": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visual:check": "node scripts/visual-check.mjs",
    "a11y:check": "node scripts/a11y-check.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "code:fix": "eslint . --ext .ts,.tsx --fix && prettier --write .",
    "code:check": "tsc --noEmit && eslint . --ext .ts,.tsx && prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@orpc/client": "^1.14.5",
    "@orpc/contract": "^1.14.5",
    "@rrweb/record": "^2.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rrweb/types": "^2.0.0-alpha.20",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "^4.12.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.2.4",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
