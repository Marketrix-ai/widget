{
  "name": "@marketrix/inapp-react",
  "version": "1.0.1",
  "description": "Modern React-based In-App Support Widget",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "marketrix-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "start": "cross-env VITE_API_URL=http://localhost:8080 vite",
    "start:local": "cross-env VITE_API_URL=http://localhost:8080 vite",
    "start:dev": "cross-env VITE_API_URL=https://api.marketrix.co vite",
    "start:prod": "cross-env VITE_API_URL=https://api.marketrix.ai vite",
    "build": "cross-env VITE_API_URL=http://localhost:8080 vite build && node -e \"require('fs').copyFileSync('index.html','dist/index.html')\"",
    "build:dev": "cross-env VITE_API_URL=https://api.marketrix.co vite build && node -e \"require('fs').copyFileSync('index.html','dist/index.html')\"",
    "build:prod": "cross-env VITE_API_URL=https://api.marketrix.ai vite build && node -e \"require('fs').copyFileSync('index.html','dist/index.html')\"",
    "preview": "cross-env VITE_API_URL=http://localhost:8080 vite preview",
    "preview:local": "cross-env VITE_API_URL=http://localhost:8080 vite preview",
    "preview:dev": "cross-env VITE_API_URL=https://api.marketrix.co vite preview",
    "preview:prod": "cross-env VITE_API_URL=https://api.marketrix.ai vite preview",
    "mcp:server": "node dist/mcp.js",
    "mcp:dev": "cross-env NODE_ENV=development tsx src/mcp-server.ts",
    "mcp:build": "cross-env VITE_API_URL=http://localhost:8080 vite build --mode mcp",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 200",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "imports:sort": "eslint . --ext .ts,.tsx --fix --rule 'simple-import-sort/imports: error'",
    "imports:unused": "eslint . --ext .ts,.tsx --fix --rule 'unused-imports/no-unused-imports: error'",
    "imports:fix": "npm run imports:sort && npm run imports:unused",
    "code:fix": "npm run imports:fix && npm run lint:fix && npm run format",
    "code:check": "npm run type-check && npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@ts-rest/core": "^3.52.1",
    "axios": "^1.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "terser": "^5.44.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-include-css": "^6.0.0"
  },
  "keywords": [
    "react",
    "widget",
    "in-app-support",
    "marketrix"
  ],
  "author": "Marketrix",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 200",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix --max-warnings 200",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ],
    "*.{png,jpg,jpeg,gif,svg,ico}": []
  }
}
