{
  "name": "@marketrix.ai/widget",
  "version": "3.8.453",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/widget.mjs",
  "module": "./dist/widget.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/widget.mjs",
      "default": "./dist/widget.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tag": "bash scripts/release.sh",
    "start": "vite",
    "build": "vite build",
    "ci": "npm run type-check && npm run lint:check && npm run build && npm run format:check && npm run test:run && npm run bundle:check",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 200 --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "check": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle:check": "node scripts/bundle-check.mjs",
    "code:fix": "eslint . --ext .ts,.tsx --fix && prettier --write .",
    "code:check": "tsc --noEmit && eslint . --ext .ts,.tsx && prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@rrweb/record": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rrweb/types": "^2.0.0-alpha.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.2.4",
    "terser": "^5.50.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
