{
  "name": "@marketrix.ai/widget",
  "version": "5.1.42",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "main": "./dist/widget.mjs",
  "module": "./dist/widget.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/widget.mjs",
      "default": "./dist/widget.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/module-sizes.json"
  ],
  "scripts": {
    "tag": "bash \"${MARKETRIX_HOME:-$HOME/code/marketrix}/infra/scripts/release.sh\"",
    "start": "vite",
    "build": "vite build",
    "ci": "bun run code:check && bun run check:comments && bun run check:types && bun run build && bun run test && bun run check:bundle && bun run check:served",
    "test": "bun test --isolate",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check:served": "bun scripts/check-served.ts",
    "check:comments": "bun scripts/check-comments.ts",
    "check:types": "bun scripts/check-types.ts",
    "code:fix": "eslint . --fix && prettier --write .",
    "code:check": "node_modules/typescript-native/bin/tsc --noEmit && eslint . --max-warnings 0 && prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@orpc/client": "^1.15.5",
    "@orpc/contract": "^1.15.5",
    "@rrweb/record": "^2.1.7",
    "zod": "~4.6.5"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rrweb/types": "^2.1.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "bun-types": "1.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "^8.3.3"
  }
}
