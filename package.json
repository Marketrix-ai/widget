{
  "name": "@marketrix.ai/widget",
  "version": "4.0.151",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "main": "./dist/widget.mjs",
  "module": "./dist/widget.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/widget.mjs",
      "default": "./dist/widget.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "tag": "bash scripts/release.sh",
    "start": "vite",
    "build": "vite build",
    "ci": "bun run code:check && bun run check:comments && bun run build && bun run test && bun run bundle:check && bun run check:served",
    "lint": "eslint . --max-warnings 0 --fix",
    "type-check": "tsc --noEmit",
    "test": "bun test --isolate",
    "test:watch": "bun test --watch --isolate",
    "test:coverage": "bun test --coverage --isolate",
    "bundle:check": "bun scripts/bundle-check.ts",
    "check:served": "bun run scripts/checkServed.ts",
    "check:comments": "bun scripts/check-comments.ts",
    "code:fix": "eslint . --fix && prettier --write .",
    "code:check": "tsc --noEmit && eslint . --max-warnings 0 && prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@orpc/client": "^1.15.1",
    "@orpc/contract": "^1.15.1",
    "@rrweb/record": "^2.1.4",
    "zod": "~4.6.5"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rrweb/types": "^2.1.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "bun-types": "1.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
