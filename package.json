{
  "name": "@marketrix/inapp-react",
  "version": "1.0.1",
  "description": "Modern React-based In-App Support Widget",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "vite",
    "start:dev": "vite --mode=dev",
    "start:prod": "vite --mode=prod",
    "build": "vite build",
    "build:dev": "vite build --mode=dev",
    "build:prod": "vite build --mode=prod",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 200",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "imports:sort": "eslint . --ext .ts,.tsx --fix --rule 'simple-import-sort/imports: error'",
    "imports:unused": "eslint . --ext .ts,.tsx --fix --rule 'unused-imports/no-unused-imports: error'",
    "imports:fix": "npm run imports:sort && npm run imports:unused",
    "code:fix": "npm run imports:fix && npm run lint:fix && npm run format",
    "code:check": "npm run type-check && npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.22",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "terser": "^5.44.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-include-css": "^6.0.0"
  },
  "keywords": [
    "react",
    "widget",
    "in-app-support",
    "marketrix"
  ],
  "author": "Marketrix",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 200",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix --max-warnings 200",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ],
    "*.{png,jpg,jpeg,gif,svg,ico}": []
  }
}
